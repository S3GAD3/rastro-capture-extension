{
  "manifest_version": 3,
  "name": "RASTRO CAPTURE",
  "version": "0.4.0",
  "description": "Captura y preservación local de contenido web, perfiles e imágenes/vídeos, optimizada para Instagram y TikTok.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "desktopCapture",
    "downloads",
    "pageCapture",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokv.us/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.muscdn.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "src/page/normalize.js",
        "src/page/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir RASTRO CAPTURE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}